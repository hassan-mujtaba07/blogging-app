<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head') %>
        <title>Blog</title>
</head>

<body>

    <%- include('./partials/nav') %>

        <div class="container mt-4">
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <h1>
                        <%= getBlog.title %>
                    </h1>
                    <img src="<%= getBlog.coverImageURL %>" class="img-fluid mb-3">
                    <p>
                        <%= getBlog.body %>
                    </p>
                </div>
            </div>
        </div>
        <div class="container mt-4">
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <img src="<%= getBlog.createdBy.profileImageURL %>" width="50px">
                    <%= getBlog.createdBy.fullName %>
                </div>
            </div>
        </div>

        <div class="container mt-3">
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <h1>Comments (<%=comments.length %>)</h1>
                    <% if (locals.user) { %>
                        <form action="/blog/comment/<%= getBlog._id %>" method="post">
                            <div class="mb-3">
                                <input type="text" name="content" class="form-control"
                                    placeholder="Enter your comment" />
                                <button class="btn btn-sm btn-primary" type="submit">Add</button>
                            </div>
                        </form>

                        <% } %>
                            <div class="mt-3">
                                <% comments.forEach(comment=> { %>
                                    <div>
                                        <img src="<%= comment.createdBy.profileImageURL %>" width="50px">
                                        <%= comment.createdBy.fullName %>
                                            <p>
                                                <%= comment.content %>
                                            </p>
                                    </div>
                                    <% }) %>
                            </div>
                </div>
            </div>
        </div>
        <%- include('./partials/script') %>

</body>

</html>